# ===== LLM 主通道（OpenAI 兼容）=====
LLM_API_KEY=your-llm-api-key
LLM_BASE_URL=https://api.openai.com/v1

# ===== LLM 备用通道（腾讯混元 Hunyuan，可选）=====
HUNYUAN_API_KEY=
HUNYUAN_BASE_URL=https://tokenhub.tencentmaas.com/v1

# ===== PostgreSQL（留空则自动回退 SQLite）=====
ZHIYAN_DB_URL=postgresql+asyncpg://zhiyan:zhiyan_dev@postgres:5432/zhiyan

# ===== Neo4j 知识图谱（留空则自动回退内存图）=====
NEO4J_URI=bolt://neo4j:7687
NEO4J_PASSWORD=zhiyan_dev

# ===== 演示数据（1=启动时注入演示数据）=====
ZHIYAN_DEMO_DATA=1

# ===== 企业认证（authn）=====
# 管理员账号（首次启动自动 seed；DB 不可用时降级内存态）
ZHIYAN_ADMIN_USERNAME=admin
ZHIYAN_ADMIN_EMAIL=admin@zhiyan.local
# ⚠️ 生产必须设置强密码，否则启动告警并生成临时密码
ZHIYAN_ADMIN_PASSWORD=
# JWT 签名密钥（HS256）。务必固定，否则重启即失效
ZHIYAN_JWT_SECRET=
# JWT 有效期（秒，默认 86400=24h）
ZHIYAN_JWT_EXPIRE=86400

# ===== 企业目录对接（可选）=====
# --- LDAP / AD（企业标配）---
# AUTH_LDAP_ENABLED=1
# AUTH_LDAP_SERVER=ldap://ad.corp.com:389
# AUTH_LDAP_BIND_DN=cn=svc,dc=corp,dc=com
# AUTH_LDAP_BIND_PASSWORD=
# AUTH_LDAP_BASE_DN=dc=corp,dc=com
# AUTH_LDAP_USER_FILTER=(sAMAccountName={user})
# AUTH_LDAP_USE_SSL=0
# 离线演示：用下列账号冒充 AD，无需真实目录即可验证登录链路
# AUTH_LDAP_MOCK=1
# AUTH_LDAP_MOCK_USERS=alice:Pass123,bob:Pass456

# --- OAuth2 / OIDC（Azure AD / 企业微信 / 飞书 / Keycloak）---
# OAUTH_ENABLED=1
# OAUTH_AUTHORIZE_URL=https://login.microsoftonline.com/<tenant>/oauth2/v2.0/authorize
# OAUTH_TOKEN_URL=https://login.microsoftonline.com/<tenant>/oauth2/v2.0/token
# OAUTH_USERINFO_URL=https://graph.microsoft.com/v1.0/me
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=
# OAUTH_SCOPE=openid profile email
# OAUTH_REDIRECT_URI=https://your-domain/authn/oauth/callback

# 目录同步来的用户默认角色
ZHIYAN_DEFAULT_DIR_ROLE=operator

# ===== 行业知识库模板 =====
# 留空=默认半导体数据；可选 shipbuilding / railway / electronics
ZHIYAN_INDUSTRY=

# ===== HTTPS（install.sh --with-tls 自动写入）=====
# ZHIYAN_TLS=1
# ZHIYAN_DOMAIN=evolviq.corp.com
