<Slide style={{ width: 1280, height: 720, position: 'relative', background: '#F1F5F9' }}>
  <Box style={{ position: 'absolute', top: 0, left: 0, width: '100%', height: 120, background: '#0B2545', justifyContent: 'center', padding: '0 64' }}>
    <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#ffffff', fontFamily: 'Microsoft YaHei' }}>如何开启：双模开户</Text>
  </Box>
  <Box style={{ height: 720, padding: '150 64 120 64', flexDirection: 'row', gap: 40 }}>
    <Box style={{ width: '32%', height: '100%', background: 'linear-gradient(135deg, #0B2545 0%, #2563EB 100%)', borderRadius: 16, padding: '32 28', flexDirection: 'column', justifyContent: 'center' }}>
      <Text style={{ fontSize: 18, color: '#06B6D4', fontFamily: 'Microsoft YaHei', fontWeight: 'bold' }}>ONBOARDING · 开户</Text>
      <Text style={{ fontSize: 38, color: '#ffffff', fontFamily: 'Microsoft YaHei', fontWeight: 'bold', marginTop: 14, lineHeight: 1.3 }}>三种通道<br />同一份画像</Text>
      <Text style={{ fontSize: 16, color: '#CBD5E1', fontFamily: 'Microsoft YaHei', lineHeight: 1.7, marginTop: 18 }}>注册即入职：首屏预生成企业画像与洞察，TTFV &lt; 60s。</Text>
    </Box>
    <Box style={{ flex: 1, height: '100%', flexDirection: 'column', justifyContent: 'space-between' }}>
      <Box style={{ background: '#ffffff', borderRadius: 12, padding: '22 26', boxShadow: '0 2px 12px rgba(11,37,69,0.06)', flexDirection: 'row', alignItems: 'center', gap: 22 }}>
        <Box style={{ width: 54, height: 54, borderRadius: 12, background: '#0B2545', justifyContent: 'center', alignItems: 'center' }}>
          <Text style={{ fontSize: 24, color: '#ffffff', fontFamily: 'Microsoft YaHei', fontWeight: 'bold' }}>01</Text>
        </Box>
        <Box style={{ flex: 1 }}>
          <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#0B2545', fontFamily: 'Microsoft YaHei' }}>名片即开户</Text>
          <Text style={{ fontSize: 16, color: '#475569', fontFamily: 'Microsoft YaHei', lineHeight: 1.6, marginTop: 6 }}>递名片或口述公司名 / 网址即启动，对话中逐步校正画像。</Text>
        </Box>
      </Box>
      <Box style={{ background: '#ffffff', borderRadius: 12, padding: '22 26', boxShadow: '0 2px 12px rgba(11,37,69,0.06)', flexDirection: 'row', alignItems: 'center', gap: 22 }}>
        <Box style={{ width: 54, height: 54, borderRadius: 12, background: '#2563EB', justifyContent: 'center', alignItems: 'center' }}>
          <Text style={{ fontSize: 24, color: '#ffffff', fontFamily: 'Microsoft YaHei', fontWeight: 'bold' }}>02</Text>
        </Box>
        <Box style={{ flex: 1 }}>
          <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#0B2545', fontFamily: 'Microsoft YaHei' }}>表单注册</Text>
          <Text style={{ fontSize: 16, color: '#475569', fontFamily: 'Microsoft YaHei', lineHeight: 1.6, marginTop: 6 }}>公司名 + 网站 + 公众号 + 选择行业，一键生成企业分身。</Text>
        </Box>
      </Box>
      <Box style={{ background: '#ffffff', borderRadius: 12, padding: '22 26', boxShadow: '0 2px 12px rgba(11,37,69,0.06)', flexDirection: 'row', alignItems: 'center', gap: 22 }}>
        <Box style={{ width: 54, height: 54, borderRadius: 12, background: '#06B6D4', justifyContent: 'center', alignItems: 'center' }}>
          <Text style={{ fontSize: 24, color: '#ffffff', fontFamily: 'Microsoft YaHei', fontWeight: 'bold' }}>03</Text>
        </Box>
        <Box style={{ flex: 1 }}>
          <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#0B2545', fontFamily: 'Microsoft YaHei' }}>事件二维码</Text>
          <Text style={{ fontSize: 16, color: '#475569', fontFamily: 'Microsoft YaHei', lineHeight: 1.6, marginTop: 6 }}>演讲现场扫码即开启个性化战略，把一次演讲变成一次开通。</Text>
        </Box>
      </Box>
    </Box>
  </Box>
  <Box style={{ position: 'absolute', bottom: 0, left: 0, width: '100%', height: 60, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', padding: '0 64' }}>
    <Text style={{ fontSize: 14, color: '#475569', fontFamily: 'Microsoft YaHei' }}>智衍 EvolvIQ · 造船行业版</Text>
