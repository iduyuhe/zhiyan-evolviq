  </Box>
  <Box style={{ position: 'absolute', bottom: 0, left: 0, width: '100%', height: 56, flexDirection: 'row', justifyContent: 'flex-end', alignItems: 'center', padding: '0 64' }}>
    <Text style={{ fontSize: 14, color: '#E2E8F0', fontFamily: 'Microsoft YaHei' }}>10 / 12</Text>
  </Box>
</Slide>
